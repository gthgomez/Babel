+++  destroy: () => Promise<void>
+++}
+++
+++/**
+++ * Extract per-page text from admitted inline PDF bytes (pdfjs-dist).
+++ */
+++export async function passagesFromAdmittedPdf(
+++  admitted: AdmittedContent,
