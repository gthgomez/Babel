{
  "//": "V2 authority adapter — Cursor CLI native permissions (3.16+).",
  "//_semantics": "deny beats allow; Shell tokens match command base + args (subcommand-aware); Read/Write globs are workspace-relative; unlisted commands prompt (approvalMode allowlist default).",
  "version": 1,
  "permissions": {
    "allow": [
      "Shell(git status)",
      "Shell(git diff)",
      "Shell(git log)",
      "Shell(git show)",
      "Shell(git branch)",
      "Shell(git fetch)",
      "Shell(git worktree)",
      "Shell(npm test)",
      "Shell(npm run test:unit)",
      "Shell(npm run lint)",
      "Shell(npm run typecheck)",
      "Shell(npm run build)",
      "Shell(npx tsc --noEmit)",
      "Shell(gh pr view)",
      "Shell(gh pr list)",
      "Shell(gh pr status)",
      "Shell(gh pr checks)",
      "Shell(gh run view)",
      "Shell(gh run list)",
      "Shell(gh run watch)",
      "Shell(gh pr create --draft)",
      "Shell(git push)",
      "Shell(git commit)",
      "WebFetch(github.com)",
      "WebFetch(docs.github.com)",
      "WebFetch(code.claude.com)",
      "WebFetch(cursor.com)",
      "WebFetch(learn.chatgpt.com)",
      "WebFetch(antigravity.google)",
      "WebFetch(api-docs.deepseek.com)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/credentials.json)",
      "Write(.env*)",
      "Write(**/*.key)",
      "Shell(git push --force)",
      "Shell(git push -f)",
      "Shell(git reset --hard)",
      "Shell(git clean -fd)",
      "Shell(git clean -fdx)",
      "Shell(rm -rf)"
    ]
  }
}
