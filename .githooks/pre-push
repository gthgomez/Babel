#!/bin/bash
# Local publication checks complement the authoritative current-candidate merge checks.
# Read actual ref/SHA records; never regenerate tracked files here.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for tool in node pwsh; do
  if ! command -v "$tool" &>/dev/null; then
    echo "[pre-push] required local tool unavailable: $tool" >&2
    exit 1
  fi
done
# A correction may supersede an older CI run. Git checks the advertised ref update;
# the merge gate still requires the new candidate's authoritative results.
node "$SCRIPT_DIR/../tools/validate-push-candidates.mjs" "${1:-origin}"
