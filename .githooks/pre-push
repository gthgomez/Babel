#!/bin/bash
# Optional feedback. Server-side checks remain authoritative.
# Read actual ref/SHA records; never regenerate tracked files here.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for tool in node pwsh; do
  if ! command -v "$tool" &>/dev/null; then
    echo "[pre-push] required local tool unavailable: $tool" >&2
    exit 1
  fi
done
node "$SCRIPT_DIR/../tools/validate-push-candidates.mjs" "${1:-origin}"
