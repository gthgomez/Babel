#!/bin/bash
# Babel pre-commit hook — delegates to PowerShell script.
# Local checks complement the authoritative current-candidate merge checks.
# Install: pwsh tools/install-hooks.ps1
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for tool in node pwsh; do
  if ! command -v "$tool" &>/dev/null; then
    echo "[pre-commit] required local tool unavailable: $tool" >&2
    exit 1
  fi
done
node "$SCRIPT_DIR/../tools/validate-push-candidates.mjs" --staged-manifest
pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-commit.ps1"
exit $?
