{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["on-error", "session-end"]
    },
    "issues": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "category": { "type": "string", "enum": ["R", "V", "T", "C", "D", "U"] },
          "error_class": { "type": "string", "enum": ["strategic", "tactical"] },
          "evidence_label": {
            "type": "string",
            "enum": ["PROVEN", "OBSERVED", "INFERRED", "UNKNOWN"]
          },
          "evidence": { "type": "string" },
          "why_trace": { "type": "string" },
          "fix_applied_now": { "type": "string" },
          "persistent_lesson": { "type": "string" }
        },
        "required": ["title", "severity", "category", "evidence", "why_trace", "persistent_lesson"]
      }
    },
    "triad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "went_well": { "type": "string" },
        "went_poorly": { "type": "string" },
        "got_lucky": { "type": "string" }
      },
      "required": ["went_well", "went_poorly", "got_lucky"]
    },
    "lessons_persisted_to": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retro_log": { "type": "string" },
    "guards_added": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["mode", "issues"]
}
