{
  "schemaVersion": 1,
  "scope": "babel-cli npm tarball top-level dist payload, bin targets and staged runtime assets",
  "classes": {
    "core": "Reachable from the default coding journey (chat, plan, deep, doctor, setup, provider/model/settings, MCP, sandbox, sessions).",
    "optional": "Reachable only from documented opt-in commands or capabilities; shipped deliberately, not pruned.",
    "test-only": "Test harness support with no runtime importer; the prepack stage must remove it.",
    "asset": "Non-compiled runtime resources staged into the package (including browser shell assets)."
  },
