{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babel.local/schemas/product-scorecard.schema.json",
  "title": "Babel CLI Product Scorecard",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "phase",
      "capability",
      "status",
      "evidence_scenario_ids",
      "user_scenario",
      "benchmark_question",
      "market_sources",
      "target_outcome"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "phase": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      },
      "capability": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "implemented",
          "partial",
          "gap",
          "not_started"
        ]
      },
      "evidence_scenario_ids": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "user_scenario": {
        "type": "string",
        "minLength": 1
      },
      "benchmark_question": {
        "type": "string",
        "minLength": 1
      },
      "market_sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "vendor",
            "title",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "vendor": {
              "type": "string",
              "enum": [
                "claude_code",
                "codex",
                "gemini_cli",
                "babel"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "target_outcome": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
