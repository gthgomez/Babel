      {
        "passage_id": "fetch-mdn-original-derived:html:overview",
        "source_revision_id": "rev-mdn-original-derived-trunc",
        "locator": { "kind": "section", "section_id": "overview" },
        "text_ref": {
          "mode": "inline",
          "text": "The HTTP cache stores a response and uses cache headers, including Cache-Control, to decide how responses are cached and reused. This overview introduces cache types and validation.",
          "text_hash": "f819829f8422aa729d30956e80295fca64afa1d7cf54322707b139bc2194ae00"
        },
        "extraction_notes": ["inline_text_truncated:host_decoded_byte_limit"]
      },
      {
        "passage_id": "fetch-mdn-original-derived:html:max-age",
        "source_revision_id": "rev-mdn-original-derived-max-age",
        "locator": { "kind": "section", "section_id": "max-age" },
        "text_ref": {
          "mode": "inline",
          "text": "The max-age directive in Cache-Control indicates the maximum time in seconds a resource is considered fresh. Browser caches honor max-age before revalidation.",
          "text_hash": "ed15af634e95db75e1fb51256d55b49853acb83c9d6066bd34c98fcb339768ba"
        }
      },
      {
        "passage_id": "fetch-cf-original-derived:html:max-age",
        "source_revision_id": "rev-cf-original-derived-complete",
        "locator": { "kind": "section", "section_id": "cache-control" },
        "text_ref": {
          "mode": "inline",
          "text": "Cache-Control max-age directive controls how long a response may be cached before revalidation is required.",
          "text_hash": "4e2867d79bbe1692b4cc32c093919410fe79c041b689568b61bf913a86567a5d"
        }
      },
      {
        "passage_id": "fetch-mdn-original-derived:html:audience",
