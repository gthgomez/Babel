        "locator": { "kind": "section", "section_id": "audience" },
        "text_ref": {
          "mode": "inline",
          "text": "This guide is written for browser-facing web developers implementing HTTP caching in user agents.",
          "text_hash": "ed95bd0c30257807eb5f38c1dac38f1beca350750a510f843a3dbb05761f1454"
        }
      },
      {
        "passage_id": "fetch-cf-original-derived:html:audience",
