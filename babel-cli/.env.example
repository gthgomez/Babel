# Babel provider credentials. Keep values blank in source control.
# Host and CI environment variables take precedence over this local file.
# Set only the credentials for the providers you select.
DEEPINFRA_API_KEY=
# Optional direct DeepSeek transport.
DEEPSEEK_API_KEY=
# OpenCode Zen (https://opencode.ai/docs/zen/) — e.g. Ox Alpha Free.
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
# Native Command Code Provider API (separate from its external CLI integration).
COMMAND_CODE_API_KEY=
# Supply through your local environment.
OPENAI_API_KEY=
# Supply through your local environment.
ANTHROPIC_API_KEY=
# Supply through your local environment.
GEMINI_API_KEY=
# Supply through your local environment.
GROQ_API_KEY=

# Optional local provider configuration.
BABEL_OLLAMA_BASE_URL=http://localhost:11434/v1
BABEL_OPENCODE_BASE_URL=https://opencode.ai/zen/v1
