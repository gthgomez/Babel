{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gthgomez/Babel/benchmarks/curated-eval/report.schema.json",
  "title": "Babel curated evaluation attempt report",
  "description": "One attempt normalized from an already completed source ChatEngine run. It is not a benchmark score by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "attempt_id", "harness_build", "adapter", "task_image", "task_revision",
    "requested_model", "sent_model", "observed_model", "terminal_status", "engine_terminal_outcome",
    "session_completed", "completion_claimed", "completion_claim_evidence", "outcome", "error_class", "errors", "verifier", "diff",
    "exposure", "usage", "started_at", "completed_at", "scripted_provider", "model_performance_claim", "model_routing"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "$ref": "#/$defs/stringOrNull" },
    "harness_build": { "$ref": "#/$defs/stringOrNull" },
    "adapter": { "type": "string", "minLength": 1 },
    "task_image": { "$ref": "#/$defs/stringOrNull" },
    "task_revision": { "$ref": "#/$defs/stringOrNull" },
    "requested_model": { "$ref": "#/$defs/stringOrNull" },
    "sent_model": { "$ref": "#/$defs/stringOrNull" },
    "observed_model": { "$ref": "#/$defs/stringOrNull" },
    "terminal_status": { "type": "string" },
    "engine_terminal_outcome": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["VERIFIED_COMPLETE", "UNVERIFIED_PATCH", "BLOCKED_EXTERNAL", "BLOCKED_POLICY", "BUDGET_EXHAUSTED", "CANCELLED", "INFRA_FAILURE", "AGENT_FAILURE", "NO_CHANGE_REQUIRED", "INVALID_TASK", "NEEDS_HUMAN_DECISION"] }
      ]
    },
    "session_completed": {
      "type": ["boolean", "null"],
      "description": "A completed session supported by the status and engine outcome; independent of patch correctness and claim truthfulness. Missing terminal evidence remains unknown."
    },
    "completion_claimed": { "type": "boolean" },
    "completion_claim_evidence": { "$ref": "#/$defs/stringOrNull" },
    "outcome": { "enum": ["valid_success", "task_failure", "infrastructure_error", "budget_truncated", "cancelled", "unknown"] },
    "error_class": { "$ref": "#/$defs/stringOrNull" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "verifier": {
      "type": "object",
      "required": ["status", "assertions", "errors"],
      "properties": {
        "status": { "type": "string" },
        "assertions": { "type": ["integer", "null"], "minimum": 0 },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "diff": {
      "type": "object",
      "required": ["added", "modified", "deleted"],
      "properties": {
        "added": { "$ref": "#/$defs/pathList" },
        "modified": { "$ref": "#/$defs/pathList" },
        "deleted": { "$ref": "#/$defs/pathList" }
      }
    },
    "exposure": {
      "type": "object",
      "required": ["oracle_visible", "reference_visible", "unexpected_reads"],
      "properties": {
        "oracle_visible": { "type": "boolean" },
        "reference_visible": { "type": "boolean" },
        "unexpected_reads": { "$ref": "#/$defs/pathList" }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cost_usd", "duration_ms", "retries"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "duration_ms": { "type": ["number", "null"], "minimum": 0 },
        "retries": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "started_at": { "$ref": "#/$defs/stringOrNull" },
    "completed_at": { "$ref": "#/$defs/stringOrNull" },
    "scripted_provider": { "type": "boolean" },
    "model_performance_claim": { "type": "boolean" },
    "model_routing": {
      "type": "object",
      "required": ["requested", "sent", "observed", "turns"],
      "properties": {
        "requested": { "$ref": "#/$defs/stringOrNull" },
        "sent": { "$ref": "#/$defs/stringOrNull" },
        "observed": { "$ref": "#/$defs/stringOrNull" },
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["turn", "requested_model", "sent_model", "observed_model", "input_tokens", "output_tokens", "cost_usd"],
            "properties": {
              "turn": { "type": ["integer", "null"], "minimum": 0 },
              "requested_model": { "$ref": "#/$defs/stringOrNull" },
              "sent_model": { "$ref": "#/$defs/stringOrNull" },
              "observed_model": { "$ref": "#/$defs/stringOrNull" },
              "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "cost_usd": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stringOrNull": { "type": ["string", "null"] },
    "pathList": { "type": "array", "items": { "type": "string" } }
  }
}
