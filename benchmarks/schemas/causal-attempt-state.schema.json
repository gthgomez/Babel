{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "babel_causal_attempt_state"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "terminal",
        "orphaned"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "enum": [
        "babel_enforce",
        "babel_shadow",
        "babel_prompt_control"
      ]
    },
    "replicate_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "substage": {
      "type": "string",
      "enum": [
        "pending",
        "infra",
        "live",
        "done"
      ]
    },
    "terminal_signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "cell_evidence_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "orphan_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "quarantined": {
      "type": "boolean"
    },
    "quarantine_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "attempt_id",
    "campaign_id",
    "lifecycle",
    "sequence",
    "updated_at",
    "pair_id",
    "task_id",
    "arm",
    "replicate_id"
  ],
  "additionalProperties": false
}
