{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "babel_causal_campaign_manifest"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "number",
      "const": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "babel_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "babel_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_root": {
          "type": "string",
          "minLength": 1
        },
        "canonical_remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset_path": {
          "type": "string",
          "minLength": 1
        },
        "dataset_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "const": "chat-headless"
        },
        "provider": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "scorer_version": {
          "type": "string",
          "minLength": 1
        },
        "safety_floor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "babel_commit",
        "babel_branch",
        "dirty_digest",
        "project_root",
        "canonical_remote",
        "dataset_path",
        "dataset_sha256",
        "model",
        "mode",
        "provider",
        "scorer_version",
        "safety_floor"
      ],
      "additionalProperties": false
    },
    "causal_stage1_complete_design": {
      "type": "boolean"
    },
    "arms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "babel_enforce",
          "babel_shadow",
          "babel_prompt_control"
        ]
      }
    },
    "replicates": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expected_attempts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "arm": {
            "type": "string",
            "enum": [
              "babel_enforce",
              "babel_shadow",
              "babel_prompt_control"
            ]
          },
          "replicate_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "arm_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "arm_config_hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "attempt_id",
          "pair_id",
          "task_id",
          "arm",
          "replicate_id",
          "arm_order",
          "arm_config_hash"
        ],
        "additionalProperties": false
      }
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "stage",
    "created_at",
    "identity",
    "causal_stage1_complete_design",
    "arms",
    "replicates",
    "expected_attempts",
    "manifest_digest"
  ],
  "additionalProperties": false
}
