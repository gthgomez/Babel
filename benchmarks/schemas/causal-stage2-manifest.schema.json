{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "babel_causal_stage2_manifest"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "number",
      "const": 2
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "parent_stage1_manifest_digest": {
      "type": "string",
      "minLength": 1
    },
    "parent_campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_attempts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "ablation_arm": {
            "type": "string",
            "enum": [
              "babel_ablation_policy_off",
              "babel_ablation_progress_off",
              "babel_ablation_budget_relaxed"
            ]
          },
          "replicate_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "arm_config_hash": {
            "type": "string",
            "minLength": 1
          },
          "triggering_stage1_attempt_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "attempt_id",
          "pair_id",
          "task_id",
          "ablation_arm",
          "replicate_id",
          "arm_config_hash",
          "triggering_stage1_attempt_ids"
        ],
        "additionalProperties": false
      }
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1
    },
    "exploratory": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "stage",
    "created_at",
    "parent_stage1_manifest_digest",
    "parent_campaign_id",
    "expected_attempts",
    "manifest_digest",
    "exploratory",
    "notes"
  ],
  "additionalProperties": false
}
