{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gthgomez/Babel/blob/main/benchmarks/schemas/verified-completion.schema.json",
  "title": "Babel verified completion",
  "type": "object",
  "required": ["schema_version", "artifact_type", "status", "run_dir", "changed_files"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "babel_verified_completion" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "task": { "type": ["string", "null"] },
    "project": { "type": ["string", "null"] },
    "run_dir": { "type": ["string", "null"] },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verifier_receipt": {
      "type": ["object", "null"],
      "required": ["command", "exit_code", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "false_complete": { "type": "boolean" },
    "failure_class": { "type": ["string", "null"] },
    "tool_call_summary": { "type": "object" },
    "blocked_report": {},
    "usage": { "type": "object" },
    "evidence_paths": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
