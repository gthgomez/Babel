      "cadence": "every_pr",
      "target_pass_rate": 0.7,
      "notes": "Single-hunk fixes, read-only diagnosis, and fast local canaries."
    },
    "B_weekly": {
      "label": "Weekly multi-hunk gate",
      "cadence": "weekly",
      "target_pass_rate": 0.5,
      "notes": "Coordinated multi-file edits, dirty worktree, and verifier discipline."
