    "C_monthly": {
      "label": "Monthly CLI stress",
      "cadence": "monthly",
      "target_pass_rate": 0.25,
      "notes": "Terminal-Bench 2.1 hard tasks via Harbor/Docker harness."
    },
    "D_governance": {
      "label": "Babel-only governance",
      "cadence": "release",
      "target_pass_rate": 0.9,
      "notes": "False-complete, injection, rollback, and exact-instruction traps."
